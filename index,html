<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Box | Tienda de Regalos en Santiago</title>
    <!-- Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Fuentes: Great Vibes (Cursiva elegante) y Nunito (Redonda y amable) -->
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Nunito:wght@300;400;700&display=swap" rel="stylesheet">
    
    <style>
        /* --- VARIABLES DE DISEÑO --- */
        :root {
            --primary-pink: #e5989b;   /* Rosa viejo elegante */
            --soft-bg: #fff5f5;        /* Fondo muy suave */
            --gold: #b5838d;           /* Tono dorado/bronce suave */
            --text-dark: #6d6875;      /* Gris violáceo suave */
            --white: #ffffff;
            --shadow: 0 10px 30px rgba(229, 152, 155, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito', sans-serif;
            color: var(--text-dark);
            background-color: var(--soft-bg);
            line-height: 1.6;
        }

        h1, h2, h3 {
            font-family: 'Great Vibes', cursive;
            font-weight: 400;
        }

        a { text-decoration: none; color: inherit; transition: 0.3s; }
        ul { list-style: none; }

        /* --- HEADER --- */
        header {
            background: var(--white);
            padding: 15px 5%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 2.2rem;
            color: var(--primary-pink);
            font-family: 'Great Vibes', cursive;
        }

        nav ul {
            display: flex;
            gap: 25px;
        }

        nav a {
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-dark);
        }

        nav a:hover { color: var(--primary-pink); }

        .menu-toggle { display: none; font-size: 1.5rem; color: var(--primary-pink); cursor: pointer; }

        /* --- HERO SECTION --- */
        .hero {
            height: 90vh;
            background: linear-gradient(rgba(255,255,255,0.3), rgba(255,255,255,0.5)), url('https://images.unsplash.com/photo-1549465220-1a8b9238cd48?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            margin-top: 70px;
        }

        .hero h1 {
            font-size: 5rem;
            color: var(--primary-pink);
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(255,255,255,0.8);
        }

        .hero p {
            font-size: 1.3rem;
            margin-bottom: 30px;
            max-width: 600px;
            font-weight: 600;
            color: var(--text-dark);
        }

        .btn-gift {
            background: var(--primary-pink);
            color: white;
            padding: 12px 35px;
            border-radius: 30px;
            font-weight: bold;
            box-shadow: var(--shadow);
            border: 2px solid transparent;
        }

        .btn-gift:hover {
            background: white;
            color: var(--primary-pink);
            border: 2px solid var(--primary-pink);
        }

        /* --- SECCIONES --- */
        section { padding: 70px 5%; }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 3.5rem;
            color: var(--gold);
            margin-bottom: 10px;
        }

        .divider {
            width: 100px;
            height: 2px;
            background: var(--primary-pink);
            margin: 0 auto;
            border-radius: 50%;
        }

        /* --- SERVICIOS Y PRODUCTOS --- */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .service-card {
            background: var(--white);
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            transition: transform 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            border: 1px solid #ffe5e5;
        }

        .service-card:hover { transform: translateY(-10px); box-shadow: var(--shadow); }

        .icon-box {
            font-size: 2.5rem;
            color: var(--primary-pink);
            margin-bottom: 20px;
        }

        .price-tag {
            display: inline-block;
            background: var(--soft-bg);
            color: var(--gold);
            padding: 5px 15px;
            border-radius: 15px;
            font-size: 0.9rem;
            font-weight: bold;
            margin-top: 15px;
        }

        /* --- GALERÍA --- */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            height: 300px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .gallery-item:hover img { transform: scale(1.1); }

        /* --- RESEÑAS --- */
        .reviews-section {
            background: var(--white);
        }

        .review-card {
            background: var(--soft-bg);
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            max-width: 800px;
            margin: 0 auto 30px auto;
            position: relative;
        }

        .stars { color: #ffb4a2; margin-bottom: 15px; font-size: 1.2rem; }
        .review-text { font-style: italic; font-size: 1.1rem; color: var(--text-dark); }
        .reviewer-name { font-weight: bold; margin-top: 15px; color: var(--primary-pink); }

        /* --- UBICACIÓN Y CONTACTO --- */
        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            background: var(--white);
            padding: 40px;
            border-radius: 20px;
            box-shadow: var(--shadow);
        }

        .info-list .item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 25px;
            font-size: 1.1rem;
        }

        .info-list i {
            width: 40px;
            height: 40px;
            background: var(--primary-pink);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 1rem;
            flex-shrink: 0;
        }

        iframe {
            width: 100%;
            height: 100%;
            min-height: 350px;
            border: 0;
            border-radius: 15px;
        }

        /* --- FOOTER --- */
        footer {
            background: var(--primary-pink);
            color: white;
            text-align: center;
            padding: 30px 20px;
        }

        /* --- WHATSAPP FLOTANTE --- */
        .float-wa {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 30px;
            right: 30px;
            background-color: #25d366;
            color: #FFF;
            border-radius: 50px;
            text-align: center;
            font-size: 35px;
            box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }
        .float-wa:hover { transform: scale(1.1); background-color: #128C7E; }

        /* --- RESPONSIVE --- */
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            
            nav ul {
                display: none;
                flex-direction: column;
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                background: white;
                text-align: center;
                padding: 20px 0;
                box-shadow: 0 5px 10px rgba(0,0,0,0.1);
            }

            nav ul.active { display: flex; }

            .hero h1 { font-size: 3.5rem; }
            
            .contact-container { grid-template-columns: 1fr; padding: 20px; }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">Detail Box</div>
        <div class="menu-toggle" onclick="toggleMenu()">
            <i class="fas fa-bars"></i>
        </div>
        <nav>
            <ul id="nav-menu">
                <li><a href="#inicio">Inicio</a></li>
                <li><a href="#servicios">Detalles</a></li>
                <li><a href="#galeria">Galería</a></li>
                <li><a href="#resenas">Reseñas</a></li>
                <li><a href="#ubicacion">Ubicación</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="inicio" class="hero">
        <h1>Detail Box</h1>
        <p>Regalos únicos, detalles especiales y la mayor variedad de Santiago.</p>
        <a href="https://wa.me/18097466048?text=Hola,%20busco%20un%20regalo%20especial." class="btn-gift" target="_blank">
            <i class="fas fa-gift"></i> Buscar un Regalo
        </a>
    </section>

    <!-- Servicios y Productos -->
    <section id="servicios">
        <div class="section-title">
            <h2>Nuestros Detalles</h2>
            <div class="divider"></div>
        </div>
        <div class="services-grid">
            <!-- Item 1 -->
            <div class="service-card">
                <div class="icon-box"><i class="fas fa-box-open"></i></div>
                <h3>Cajas Personalizadas</h3>
                <p>Armamos la caja perfecta con los detalles que esa persona especial ama.</p>
                <span class="price-tag">Desde RD$ 1,500</span>
            </div>
            <!-- Item 2 -->
            <div class="service-card">
                <div class="icon-box"><i class="fas fa-balloon"></i></div>
                <h3>Globos y Decoración</h3>
                <p>Gran variedad de globos y accesorios para hacer tu celebración inolvidable.</p>
                <span class="price-tag">Consultar Diseños</span>
            </div>
            <!-- Item 3 -->
            <div class="service-card">
                <div class="icon-box"><i class="fas fa-heart"></i></div>
                <h3>Detalles Únicos</h3>
                <p>Cosas curiosas y diferentes que no encontrarás en ningún otro lugar.</p>
                <span class="price-tag">Variedad de Precios</span>
            </div>
        </div>
    </section>

    <!-- Galería -->
    <section id="galeria" style="background-color: var(--white);">
        <div class="section-title">
            <h2>Inspiración de Regalos</h2>
            <div class="divider"></div>
        </div>
        <div class="gallery-grid">
            <div class="gallery-item"><img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=500&q=60" alt="Regalo 1"></div>
            <div class="gallery-item"><img src="https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&fit=crop&w=500&q=60" alt="Regalo 2"></div>
            <div class="gallery-item"><img src="https://images.unsplash.com/photo-1513885535751-8b9238bd345a?auto=format&fit=crop&w=500&q=60" alt="Regalo 3"></div>
            <div class="gallery-item"><img src="https://images.unsplash.com/photo-1577215902096-7c6de347344f?auto=format&fit=crop&w=500&q=60" alt="Regalo 4"></div>
        </div>
    </section>

    <!-- Reseñas -->
    <section id="resenas" class="reviews-section">
        <div class="section-title">
            <h2>Clientes Felices</h2>
            <div class="divider"></div>
            <p style="margin-top: 10px;">Calificación Perfecta: 5.0 <i class="fas fa-star" style="color:#ffb4a2"></i></p>
        </div>
        
        <div class="review-card">
            <div class="stars">
                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
            </div>
            <p class="review-text">"Gran variedad de productos perfectos para regalar a alguien especial. Tiene una gran variedad de servicios y productos en comparación con otros gift shops."</p>
            <p class="reviewer-name">- Lulu (Local Guide)</p>
        </div>

        <div class="review-card">
            <div class="stars">
                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
            </div>
            <p class="review-text">"Muchas cosas curiosas y diferentes puedes encontrar como opción para regalar algún detalle diferente."</p>
            <p class="reviewer-name">- Denys Reyes Rodriguez</p>
        </div>
    </section>

    <!-- Ubicación y Contacto -->
    <section id="ubicacion">
        <div class="section-title">
            <h2>Visítanos</h2>
            <div class="divider"></div>
        </div>
        <div class="contact-container">
            <!-- Info -->
            <div class="info-list">
                <div class="item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <strong>Dirección:</strong><br>
                        Dr. Arturo Grullón 23,<br>
                        Santiago de los Caballeros 51000,<br>
                        República Dominicana
                    </div>
                </div>
                
                <div class="item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <strong>Horarios:</strong><br>
                        Consultar disponibilidad<br>
                        <span style="font-size: 0.9em; color: var(--primary-pink);">*Abierto hoy</span>
                    </div>
                </div>

                <div class="item">
                    <i class="fas fa-phone-alt"></i>
                    <div>
                        <strong>Teléfono / WhatsApp:</strong><br>
                        <a href="tel:+18097466048" style="font-weight: bold; color: var(--primary-pink);">+1 809-746-6048</a>
                    </div>
                </div>

                <div class="item">
                    <i class="fas fa-truck"></i>
                    <div>
                        <strong>Servicios:</strong><br>
                        Entrega a domicilio disponible
                    </div>
                </div>

                <a href="https://maps.google.com/?q=Dr.+Arturo+Grullón+23,+Santiago+de+los+Caballeros" target="_blank" class="btn-gift" style="display:inline-block; margin-top: 20px; font-size: 0.9rem; padding: 10px 25px;">
                    <i class="fas fa-location-arrow"></i> Cómo llegar
                </a>
            </div>

            <!-- Mapa -->
            <div class="map-box">
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.123456!2d-70.69!3d19.46!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zRHIuIEFydHVybyBHcnVsbMOzbiAyMywgU2FudGlhZ28!5e0!4v1620000000000!5m2!1ses!2sdo" 
                    allowfullscreen="" 
                    loading="lazy">
                </iframe>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <h3>Detail Box</h3>
        <p>Haciendo momentos especiales desde Santiago.</p>
        <p style="margin-top: 20px; font-size: 0.8rem;">&copy; 2026 Detail Box. Todos los derechos reservados.</p>
    </footer>

    <!-- Botón Flotante WhatsApp -->
    <a href="https://wa.me/18097466048?text=Hola,%20vi%20su%20página%20web%20y%20quiero%20información%20sobre%20un%20regalo." class="float-wa" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <!-- Script Menú Móvil -->
    <script>
        function toggleMenu() {
            var menu = document.getElementById('nav-menu');
            menu.classList.toggle('active');
        }
    </script>
</body>
</html>
